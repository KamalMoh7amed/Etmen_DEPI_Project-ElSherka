        setTimeout(drawActiveOutbreakZones, 2000);
        loadDoctorWorkloadStats();
        setInterval(loadDoctorWorkloadStats, 20000);
    });
    // 7. Load Doctor Workload and Fatigue Stats
    function loadDoctorWorkloadStats() {
        $("#workloadLoader").removeClass("d-none");
        $.ajax({
            url: "/HospitalQueue/GetWorkloadStats",
            type: "GET",
            success: function(res) {
                $("#workloadLoader").addClass("d-none");
                if (res.success && res.data) {
                    var html = "";
                    res.data.forEach(function(item) {
                        var badgeClass = "bg-success";
                        var text = "عبء منخفض";
                        if (item.loadStatus === "High") {
                            badgeClass = "bg-danger animate__animated animate__flash animate__infinite";
                            text = "إجهاد شديد";
                        } else if (item.loadStatus === "Medium") {
                            badgeClass = "bg-warning text-dark";
                            text = "نشط";
                        }
                        html += `<div class="d-flex align-items-center justify-content-between p-2 rounded-3 border bg-white small">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fas fa-user-md text-secondary"></i>
                                <div>
                                    <div class="fw-bold text-dark">${item.name}</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">${item.specialization}</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge ${badgeClass} rounded-pill px-2.5 py-1 mb-1 d-inline-block" style="font-size: 0.65rem;">${text}</span>
                                <div class="text-muted font-monospace" style="font-size: 0.7rem;">${item.activeCases} حالات نشطة</div>
                            </div>
                        </div>`;
                    });
                    if (res.data.length === 0) {
                        html = `<div class="text-center text-muted py-3 small">لا يوجد أطباء مناوبين مسجلين حالياً.</div>`;
                    }
                    $("#workloadStatsContainer").html(html);
                }
            }
        });
    }
