                color: '#ef4444',
                fillColor: '#ef4444',
                fillOpacity: 0.15,
                radius: 1200
            }).addTo(dispMap).bindPopup("<div style='text-align:right;'><b>منطقة وباء نشطة</b><br>حالات اشتباه حمى الضنك</div>");
        }
    }
