    // 3. AI Load Prediction Gauge
    function loadAiPrediction() {
        $.ajax({
            url: "/HospitalQueue/GetAILoadPrediction",
            type: "GET",
            success: function(res) {
                if (res.success) {
                    var score = res.score;
                    $("#aiLoadScore").text(score + "%");
                    $("#aiLoadText").text(res.text);
                    var gauge = document.getElementById("aiLoadGauge");
                    if (gauge) {
                        gauge.setAttribute("stroke-dasharray", score + ", 100");
                        if (score >= 75) {
                            gauge.setAttribute("stroke", "#ef4444");
                            $("#aiLoadDetails").html("⚠️ ضغط شديد جداً بالمنطقة. ينصح باستدعاء أطباء مناوبين احتياطيين وإخلاء الأسرة الجاهزة.");
                        } else if (score >= 50) {
                            gauge.setAttribute("stroke", "#f97316");
                            $("#aiLoadDetails").html("⚡ ضغط عمل نشط. يرجى متابعة سرعة الفرز لضمان عدم حدوث تكدس.");
                        } else {
                            gauge.setAttribute("stroke", "#22c55e");
                            $("#aiLoadDetails").html("✅ الوردية مستقرة تماماً. القدرة التشغيلية الحالية للمستشفى ممتازة.");
                        }
                    }
                }
            }
        });
    }
    // Call AI predictor on load
    $(document).ready(function() {
        loadAiPrediction();
        setInterval(loadAiPrediction, 30000);
        // Update Admitted Patients count on tab load
        $.ajax({
            url: "/HospitalQueue/GetAdmittedPatients",
            type: "GET",
            success: function(res) {
                if (res.success && res.data) {
                    $("#admittedCountBadge").text(res.data.length);
                }
            }
        });
    });
    // 4. SignalR Real-Time Shift Handover & Chat & Code Blue Alerts
    var queueHubConnection = new signalR.HubConnectionBuilder()
        .withUrl("/queueHub")
        .build();
    queueHubConnection.start().then(function() {
        queueHubConnection.invoke("JoinProviderGroup", "@Model.ProviderId");
        console.log("QueueHub SignalR connected & joined hospital group @Model.ProviderId");
    }).catch(function(err) {
        console.error(err.toString());
    });
    queueHubConnection.on("ReceiveInternalChatMessage", function(senderName, messageText, timeStr) {
        var chatBox = document.getElementById("internalChatMessages");
        var emailStr = "@User.Identity?.Name";
        var isMe = senderName === emailStr;
        var senderLabel = isMe ? "أنا" : senderName.split('@@')[0];
        var messageHtml = `<div class="d-flex flex-column ${isMe ? 'align-items-start' : 'align-items-end'}">
            <span class="text-muted" style="font-size: 0.65rem;">${senderLabel} · ${timeStr}</span>
            <div class="p-2 rounded-3 text-dark mt-0.5" style="background: ${isMe ? '#dbeafe' : '#f1f5f9'}; max-width: 90%; font-size: 0.78rem;">
                ${messageText}
            </div>
        </div>`;
        $("#internalChatMessages").append(messageHtml);
        chatBox.scrollTop = chatBox.scrollHeight;
    });
    queueHubConnection.on("ReceiveEmergencyCode", function(senderName, codeName, locationDetails) {
        $("#codeAlertTitle").text(`تفعيل كود طوارئ: كود ${codeName}`);
        $("#codeAlertLocation").text(`الموقع: ${locationDetails} · مفعل بواسطة: ${senderName.split('@@')[0]}`);
        $("#codeBlueOverlay").removeClass("d-none");
        var audio = document.getElementById("codeBlueSound");
        if (audio) {
            audio.currentTime = 0;
            audio.play().catch(function(e) {
                console.log("Audio play blocked by browser policy.");
            });
        }
    });
    window.sendShiftMessage = function() {
        var msg = $("#internalChatInput").val().trim();
        if (msg === "") return;
        queueHubConnection.invoke("SendInternalChatMessage", @Model.ProviderId, "@User.Identity?.Name", msg)
            .then(function() {
                $("#internalChatInput").val("");
            });
    };
    window.handleChatKey = function(e) {
        if (e.which === 13) {
            sendShiftMessage();
        }
    };
    window.activateCode = function(codeName, defaultLocation) {
        var loc = prompt("يرجى إدخال موقع تفعيل الكود بدقة:", defaultLocation);
        if (loc === null) return;
        if (loc.trim() === "") loc = defaultLocation;
        queueHubConnection.invoke("ActivateEmergencyCode", @Model.ProviderId, "@User.Identity?.Name", codeName, loc.trim());
    };
    window.dismissCodeBlue = function() {
        $("#codeBlueOverlay").addClass("d-none");
        var audio = document.getElementById("codeBlueSound");
        if (audio) {
            audio.pause();
        }
    };
