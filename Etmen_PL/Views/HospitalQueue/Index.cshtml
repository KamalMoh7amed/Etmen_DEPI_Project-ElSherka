                        <i class="fas fa-bed-pulse fs-1 text-secondary mb-3"></i>
                        <h5>لا يوجد مرضى منومين حالياً.</h5>
                        <p class="small mb-0">جميع الحالات السابقة تم تخريجها أو تحويلها.</p>
                    </div>
                </div>
                <!-- Visual Bed Grid Tab Pane -->
                <div class="tab-pane fade" id="bed-grid-pane" role="tabpanel">
                    <div class="alert alert-info border-0 p-3 rounded-4 mb-4 small bg-transparent-info text-info">
                        <i class="fas fa-circle-info me-1"></i>
                        مخطط الأسرة التفاعلي يوضح نسبة إشغال الطوارئ والرعاية. انقر على السرير الأحمر لعرض بيانات وتوصيات الحالة المنوّمة فيه.
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0"><i class="fas fa-hospital text-primary me-2"></i>توزيع أسرة الطوارئ والرعاية</h5>
                        <div class="d-flex gap-3 text-xs" style="font-size: 0.8rem;">
                            <span><span class="d-inline-block rounded-circle bg-success me-1" style="width: 10px; height: 10px;"></span> سرير متاح</span>
                            <span><span class="d-inline-block rounded-circle bg-danger me-1" style="width: 10px; height: 10px;"></span> سرير مشغول</span>
                        </div>
                    </div>
                    <div class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-3 mb-4" id="visualBedsGrid">
                        <!-- Dynamic Bed Cards will be rendered here by Javascript -->
                    </div>
                </div>
                <!-- Shift Handovers Tab Pane -->
                <div class="tab-pane fade" id="handovers-pane" role="tabpanel">
                    <div class="row g-4">
                        <div class="col-md-5">
                            <div class="card border-0 bg-transparent p-4 rounded-4 shadow-sm">
                                <h5 class="fw-bold text-dark mb-3"><i class="fas fa-file-signature text-primary me-2"></i>تسليم الوردية الحالية</h5>
                                <p class="small text-muted mb-3">قم بتدوين كافة الملاحظات التشغيلية والأسرة المعطلة أو الحالات الحرجة لتسليمها للوردية القادمة.</p>
                                <form asp-controller="HospitalQueue" asp-action="SaveHandover" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3">
                                        <label class="form-label small fw-800 text-muted">ملاحظات وتقرير التسليم:</label>
                                        <textarea class="form-control rounded-3" name="handoverNotes" rows="6" required placeholder="مثال: الوردية مستقرة. يتواجد مريضين بقسم الملاحظة، السرير رقم 8 قيد التعقيم..."></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2.5 fw-bold">
                                        <i class="fas fa-paper-plane me-1"></i> حفظ وتوقيع تقرير التسليم
                                    </button>
                                </form>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <h5 class="fw-bold text-dark mb-3"><i class="fas fa-history text-secondary me-2"></i>سجل عمليات تسليم الورديات السابقة</h5>
                            <div class="list-group shadow-sm rounded-4 overflow-hidden" id="handoverLogsList" style="max-height: 400px; overflow-y: auto;">
                                @if (ViewBag.HandoverLogs != null && ((List<Etmen_BLL.DTOs.HospitalStaff.StaffActivityLogDto>)ViewBag.HandoverLogs).Count > 0)
                                {
                                    foreach (var log in (List<Etmen_BLL.DTOs.HospitalStaff.StaffActivityLogDto>)ViewBag.HandoverLogs)
                                    {
                                        <div class="list-group-item border-0 border-bottom p-3 bg-white">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-bold text-primary small"><i class="fas fa-user-clock me-1"></i> @log.StaffName</span>
                                                <span class="text-muted font-monospace" style="font-size: 0.75rem;">@log.CreatedAt.ToString("g")</span>
                                            </div>
                                            <p class="small text-dark mb-0 bg-transparent p-2 rounded-2 mt-1" style="white-space: pre-wrap;">@log.Details</p>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center py-5 text-muted bg-white">
                                        <i class="fas fa-folder-open fs-1 mb-2 text-muted"></i>
                                        <p class="small mb-0">لا توجد سجلات تسليم ورديات سابقة.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Right side: Sidebar Widgets -->
    <div class="col-lg-4">
        <!-- Hospital Profile Control Card (Full Control) -->
        <div class="dashboard-card animate__animated animate__fadeInRight">
            <h3 class="card-title-lg">
                <i class="fas fa-sliders text-primary"></i>
                التحكم الكامل في بيانات المستشفى
            </h3>
            <form asp-controller="HospitalQueue" asp-action="UpdateProfile" method="post" class="mt-2">
                <input type="hidden" name="ProviderId" value="@Model.ProviderId" />
                <!-- Hospital Name -->
                <div class="mb-3">
                    <label class="form-label small fw-800 text-muted">اسم المنشأة الطبية/المستشفى:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="fas fa-hospital text-muted"></i></span>
                        <input type="text" class="form-control" name="ProviderName" value="@Model.ProviderName" required placeholder="مثال: مستشفى الشفاء التخصصي" />
                    </div>
                </div>
                <!-- Hospital Region/Address -->
                <div class="mb-3">
                    <label class="form-label small fw-800 text-muted">منطقة التغطية/العنوان:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="fas fa-map-marker-alt text-muted"></i></span>
                        <input type="text" class="form-control" name="ProviderAddress" value="@Model.ProviderAddress" placeholder="مثال: القاهرة - التجمع الخامس" />
                    </div>
                </div>
                <!-- Available Beds & BedCapacity -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-800 text-muted mb-0">سعة الأسرة الإجمالية:</label>
                        <span class="badge bg-secondary font-monospace" id="bedCapVal">@(Model.BedCapacity ?? 150)</span>
                    </div>
                    <input type="range" class="form-range" name="BedCapacity" id="bedCapRange" min="10" max="500" value="@(Model.BedCapacity ?? 150)" oninput="updateBedCapLabel(this.value)">
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-800 text-muted mb-0">الأسرة الشاغرة (المتاحة):</label>
                        <span class="badge font-monospace text-white" id="bedVal" style="transition: all 0.3s ease;">@(Model.AvailableBeds ?? 0)</span>
                    </div>
                    <input type="range" class="form-range" name="AvailableBeds" id="bedRange" min="0" max="@(Model.BedCapacity ?? 150)" value="@(Model.AvailableBeds ?? 0)" oninput="updateBedLabel(this.value)">
                </div>
                <hr class="my-3" style="opacity: 0.15;" />
                <!-- Available Ambulances & AmbulanceCapacity -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-800 text-muted mb-0">سعة سيارات الإسعاف الإجمالية:</label>
                        <span class="badge bg-secondary font-monospace" id="ambCapVal">@(Model.AmbulanceCapacity ?? 4)</span>
                    </div>
                    <input type="range" class="form-range" name="AmbulanceCapacity" id="ambCapRange" min="1" max="25" value="@(Model.AmbulanceCapacity ?? 4)" oninput="updateAmbCapLabel(this.value)">
                </div>
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-800 text-muted mb-0">سيارات الإسعاف المتاحة (الشاغرة):</label>
                        <span class="badge font-monospace text-white" id="ambVal" style="transition: all 0.3s ease;">@(Model.AvailableAmbulances ?? 4)</span>
                    </div>
                    <input type="range" class="form-range" name="AvailableAmbulances" id="ambRange" min="0" max="@(Model.AmbulanceCapacity ?? 4)" value="@(Model.AvailableAmbulances ?? 4)" oninput="updateAmbLabel(this.value)">
                </div>
                <button type="submit" class="btn btn-primary w-100 rounded-pill py-2.5 fw-800">
                    <i class="fas fa-sync-alt me-1"></i> حفظ وتحديث البيانات الآن
                </button>
            </form>
        </div>
        <!-- AI Load Predictor Card -->
        <div class="dashboard-card animate__animated animate__fadeInRight" style="animation-delay: 0.05s;">
            <h3 class="card-title-lg">
                <i class="fas fa-brain text-purple" style="color: #a855f7;"></i>
                متنبئ الازدحام والضغط الذكي (AI)
            </h3>
            <div class="text-center py-3">
                <div class="position-relative d-inline-block" style="width: 120px; height: 120px;">
                    <svg viewBox="0 0 36 36" class="circular-chart" style="transform: rotate(-90deg); width: 100%; height: 100%;">
                        <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#e2e8f0" stroke-width="3" />
                        <path class="circle" id="aiLoadGauge" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#22c55e" stroke-width="3" stroke-dasharray="30, 100" style="transition: stroke-dasharray 1s ease, stroke 1s ease;" />
                    </svg>
                    <div class="position-absolute top-50 start-50 translate-middle text-center">
                        <span class="fs-4 fw-900 text-dark" id="aiLoadScore">--%</span>
                    </div>
                </div>
                <h6 class="fw-bold text-dark mt-2 mb-1" id="aiLoadText">جاري الحساب...</h6>
                <p class="small text-muted mb-0 px-2" style="font-size: 0.75rem;" id="aiLoadDetails">جاري تحليل البيانات...</p>
            </div>
        </div>
        <!-- Staff Workload & Fatigue Tracker Card -->
        <div class="dashboard-card animate__animated animate__fadeInRight" style="animation-delay: 0.1s;">
            <h3 class="card-title-lg">
                <i class="fas fa-user-doctor text-info"></i>
                مؤشر ضغط العمل وإجهاد الأطباء (Fatigue Tracker)
            </h3>
            <p class="small text-muted mb-3">عبء العمل للمناوبين وحالتهم الصحية لمنع الاحتراق المهني.</p>
            <div id="workloadLoader" class="text-center py-2 d-none">
                <i class="fas fa-spinner fa-spin text-info"></i>
            </div>
            <div id="workloadStatsContainer" class="d-flex flex-column gap-2" style="max-height: 180px; overflow-y: auto;">
                <!-- Dynamic workload rows -->
            </div>
        </div>
        <!-- Emergency Codes Panel -->
        <div class="dashboard-card animate__animated animate__fadeInRight" style="animation-delay: 0.15s;">
            <h3 class="card-title-lg">
                <i class="fas fa-tower-broadcast text-danger"></i>
                أكواد الطوارئ السريعة (Code Activation)
            </h3>
            <p class="small text-muted mb-3">اضغط لتفعيل إنذار فوري لكود طبي طارئ داخل مبنى الطوارئ بأكمله.</p>
            <div class="row g-2">
                <div class="col-6">
                    <button type="button" class="btn w-100 py-3 fw-bold btn-danger" style="background: #ef4444; border: none; box-shadow: 0 4px 10px rgba(239, 68, 68, 0.2);" onclick="activateCode('Blue', 'قسم الاستقبال الطارئ')">
                        <i class="fas fa-heart-pulse me-1"></i> كود أزرق (عناية)
                    </button>
                </div>
                <div class="col-6">
                    <button type="button" class="btn w-100 py-3 fw-bold text-white" style="background: #f97316; border: none; box-shadow: 0 4px 10px rgba(249, 115, 22, 0.2);" onclick="activateCode('Red', 'المستودع الطبي')">
                        <i class="fas fa-fire me-1"></i> كود أحمر (حريق)
                    </button>
                </div>
                <div class="col-12 mt-2">
                    <button type="button" class="btn w-100 py-2.5 fw-bold btn-dark" style="background: #1e293b; border: none;" onclick="activateCode('Black', 'صالة الاستقبال الرئيسية')">
                        <i class="fas fa-shield-halved me-1"></i> كود أسود (أمني)
                    </button>
                </div>
            </div>
        </div>
        <!-- Shift Internal Chat Room -->
        <div class="dashboard-card animate__animated animate__fadeInRight" style="animation-delay: 0.25s;">
            <h3 class="card-title-lg mb-2">
                <i class="fas fa-comments text-success"></i>
                غرفة محادثة الوردية الحالية
            </h3>
            <div class="border rounded-3 bg-transparent p-2 mb-2 d-flex flex-column" style="height: 180px;">
                <div id="internalChatMessages" class="flex-grow-1 overflow-y-auto small d-flex flex-column gap-2" style="max-height: 160px; min-height: 140px;">
                    <div class="text-center text-muted py-3" style="font-size: 0.75rem;">مرحباً بك في شات الوردية للتنسيق اللوجستي السريع.</div>
                </div>
            </div>
            <div class="input-group">
                <input type="text" id="internalChatInput" class="form-control rounded-start-pill small" placeholder="اكتب رسالة للوردية..." style="font-size: 0.85rem;" onkeypress="handleChatKey(event)" />
                <button class="btn btn-success rounded-end-pill px-3" type="button" onclick="sendShiftMessage()"><i class="fas fa-paper-plane"></i></button>
            </div>
        </div>
        <!-- Central Administration Communications (Communicate with Admin) -->
        <div class="dashboard-card animate__animated animate__fadeInRight" style="animation-delay: 0.1s;">
            <h3 class="card-title-lg">
                <i class="fas fa-tower-broadcast text-danger"></i>
                التواصل مع الإدارة المركزية للأزمات
            </h3>
            <p class="small text-muted mb-3">يمكنك طلب دعم لوجستي عاجل من الأدمن أو بدء محادثة حية مع غرفة إدارة الكوارث المركزية.</p>
            <div class="d-flex flex-column gap-3">
                <!-- Direct Support Alert Request Form -->
                <form asp-controller="HospitalQueue" asp-action="RequestSupport" method="post" onsubmit="return confirm('هل أنت متأكد من رغبتك في إرسال طلب دعم عاجل للأدمن لزيادة الإمدادات والأسرة؟');">
                    <input type="hidden" name="ProviderId" value="@Model.ProviderId" />
                    <button type="submit" class="btn btn-emergency-support w-100 py-3 text-center">
                        <i class="fas fa-triangle-exclamation me-1 animate__animated animate__pulse animate__infinite"></i>
                        طلب دعم وإمداد طبي عاجل
                    </button>
                </form>
                <!-- Direct Live Chat with Admin -->
                @if (!string.IsNullOrEmpty(Model.AdminUserId))
                {
                    <a href="/Chat/Thread?otherUserId=@Model.AdminUserId" class="btn btn-outline-primary w-100 rounded-pill py-2.5 fw-800">
                        <i class="fas fa-comments me-1"></i>
                        فتح محادثة مباشرة مع الأدمن
                    </a>
                }
                else
                {
                    <button class="btn btn-outline-secondary w-100 rounded-pill py-2.5 fw-800" disabled>
                        <i class="fas fa-comments-slash me-1"></i>
                        الدردشة غير متاحة (الأدمن غير مسجل)
                    </button>
                }
            </div>
        </div>
        <!-- ════════════════════════════════════════════
             Ambulance Live Dispatch Map Card
        ════════════════════════════════════════════ -->
        <div class="dashboard-card animate__animated animate__fadeInRight" style="animation-delay: 0.2s; padding:18px;">
            <h3 class="card-title-lg" style="font-size:1.05rem;margin-bottom:14px;">
                <i class="fas fa-satellite text-info animate__animated animate__pulse animate__infinite"></i>
                خريطة الإسعاف المباشرة
            </h3>
            <!-- Capacity Bar -->
            <div class="d-flex justify-content-between align-items-center mb-1" style="font-size:.8rem;">
                <span class="fw-700 text-muted"><i class="fas fa-ambulance me-1 text-danger"></i> السعة</span>
                <span id="capLabel" class="fw-800"></span>
            </div>
            <div style="background:rgba(255,255,255,0.02);border-radius:8px;height:10px;overflow:hidden;margin-bottom:12px;">
                <div id="capBar" style="height:100%;border-radius:8px;transition:width .6s ease;background:#22c55e;"></div>
            </div>
            <!-- No-ambulance alert -->
            <div id="noAmbHospAlert" class="alert alert-danger border-0 py-2 px-3 mb-2 small fw-700"
                 style="border-radius:10px;display:none;">
                <i class="fas fa-exclamation-triangle me-1"></i>
                جميع سيارات الإسعاف مشغولة!
                <div id="altHospText" class="fw-600 mt-1" style="font-size:.75rem;"></div>
            </div>
            <!-- Map -->
            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
            <div class="position-relative">
                <div class="map-overlay-header">
                    <div class="overlay-icon"><i class="fas fa-star-of-life"></i></div>
                    <div class="overlay-details">
                        <div class="overlay-title">EMERGENCY MEDICAL DASHBOARD</div>
                        <div class="overlay-status"><span class="utc-clock">--:--:-- UTC</span> | <span class="live-indicator">LIVE</span></div>
                    </div>
                </div>
                <div id="hospAmbMap" style="height:280px;border-radius:14px;overflow:hidden;
                     border:2px solid #1e293b;box-shadow:0 0 25px rgba(0, 240, 255, 0.12);"></div>
            </div>
            <!-- Legend -->
            <div class="d-flex gap-3 justify-content-center mt-2 flex-wrap" style="font-size:.75rem;color:#64748b;">
                <span>🏥 المستشفى</span>
                <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#ef4444;border:1px solid #fff;"></span> المريض</span>
                <span>🚑 إسعاف متحرك</span>
                <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#22c55e;"></span> إسعاف متاح</span>
            </div>
            <!-- Active dispatch list -->
            <div id="dispatchList" class="mt-3" style="max-height:160px;overflow-y:auto;"></div>
        </div>
    </div>
</div>
<!-- Full-Screen Emergency Code Blue Overlay -->
<div id="codeBlueOverlay" class="position-fixed top-0 start-0 w-100 h-100 d-none align-items-center justify-content-center" style="z-index: 10000; background: rgba(0,0,0,0.95); transition: all 0.5s ease;">
    <div class="text-center text-white p-5 rounded-4 animate__animated animate__zoomIn" style="border: 4px solid #ef4444; box-shadow: 0 0 50px rgba(239, 68, 68, 0.5); max-width: 500px; background: #0f172a; direction: rtl;">
        <i class="fas fa-triangle-exclamation text-danger fs-1 animate__animated animate__flash animate__infinite mb-3" style="font-size: 4rem !important;"></i>
