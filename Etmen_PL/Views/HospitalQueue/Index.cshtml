@model Etmen_PL.Models.ViewModels.Hospital.HospitalQueueViewModel
@{
    ViewData["Title"] = "لوحة فرز الحالات وغرفة العمليات";
    Layout = "~/Views/Shared/_HospitalStaffLayout.cshtml";
    // Separate items by status
    var pendingItems = Model.Items.Where(i => i.Status == "Pending" && i.EmergencyType != "DoctorTransfer").ToList();
    var generalPending = pendingItems.Where(i => i.AssignedProviderId == null).ToList();
    var directPending = pendingItems.Where(i => i.AssignedProviderId == Model.ProviderId).ToList();
    var acceptedItems = Model.Items.Where(i => i.Status == "Accepted" && i.EmergencyType != "DoctorTransfer").ToList();
    var escalatedItems = Model.Items.Where(i => i.Status == "Escalated" && i.EmergencyType != "DoctorTransfer").ToList();
    var doctorTransfers = Model.Items.Where(i => i.EmergencyType == "DoctorTransfer").ToList();
    // Priority statistics
    var criticalCount = Model.Items.Count(i => i.PriorityScore >= 80);
    var mediumCount = Model.Items.Count(i => i.PriorityScore >= 55 && i.PriorityScore < 80);
    var lowCount = Model.Items.Count(i => i.PriorityScore < 55);
}
<style>
    /* Dynamic telemetry alert colors */
    @@keyframes pulseRed {
        0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); transform: scale(1); }
        70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); transform: scale(1.05); }
        100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); transform: scale(1); }
    }
    .pulsing-red-alert {
        background-color: #ef4444 !important;
        color: #ffffff !important;
        animation: pulseRed 1.5s infinite;
        display: inline-block;
    }
    /* ── Map Overlay Header ── */
    .map-overlay-header {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 1000;
        display: flex;
        align-items: center;
        background: rgba(10, 25, 41, 0.85);
        border: 1.5px solid rgba(0, 240, 255, 0.45);
        border-radius: 10px;
        padding: 6px 12px;
        box-shadow: 0 4px 15px rgba(0, 240, 255, 0.2);
        backdrop-filter: blur(6px);
        pointer-events: none;
    }
    .overlay-icon {
        font-size: 14px;
        color: #00f0ff;
        margin-right: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        background: rgba(0, 240, 255, 0.1);
        border-radius: 6px;
        animation: pulse-glow 2s infinite;
    }
    .overlay-details {
        display: flex;
        flex-direction: column;
        text-align: left;
    }
    .overlay-title {
        font-family: 'Outfit', 'Inter', sans-serif;
        font-size: 9px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: 0.8px;
        margin: 0;
        line-height: 1.1;
    }
    .overlay-status {
        font-family: 'Inter', sans-serif;
        font-size: 8px;
        color: rgba(255, 255, 255, 0.6);
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 1px;
    }
    .live-indicator {
        color: #ff4d4d;
        font-weight: 700;
        animation: flash-live 1s infinite alternate;
    }
    @@keyframes flash-live {
        0% { opacity: 0.5; }
        100% { opacity: 1; }
    }
    @@keyframes pulse-glow {
        0% { box-shadow: 0 0 0 0 rgba(0, 240, 255, 0.4); }
        70% { box-shadow: 0 0 0 8px rgba(0, 240, 255, 0); }
        100% { box-shadow: 0 0 0 0 rgba(0, 240, 255, 0); }
    }
    /* ── Glow Badge Styling ── */
    .glow-badge {
        display: flex;
        align-items: center;
        background: rgba(10, 25, 41, 0.9);
        border: 1.5px solid #00f0ff;
        border-radius: 20px;
        padding: 4px 10px 4px 6px;
        box-shadow: 0 0 15px rgba(0, 240, 255, 0.35);
        color: #ffffff;
        font-family: 'Inter', sans-serif;
        white-space: nowrap;
        width: fit-content;
    }
    .glow-badge.orange {
        border-color: #ff9f00;
        box-shadow: 0 0 15px rgba(255, 159, 0, 0.35);
    }
    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #00f0ff;
        border-radius: 50%;
        margin-right: 6px;
        margin-left: 2px;
        position: relative;
        flex-shrink: 0;
    }
    .glow-badge.orange .pulse-dot {
        background: #ff9f00;
    }
    .pulse-dot::after {
        content: '';
        position: absolute;
        top: -6px;
        left: -6px;
        right: -6px;
        bottom: -6px;
        border: 2px solid #00f0ff;
        border-radius: 50%;
        animation: pulse-ring 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
    }
    .glow-badge.orange .pulse-dot::after {
        border-color: #ff9f00;
    }
    @@keyframes pulse-ring {
        0% { transform: scale(0.35); opacity: 1; }
        50% { opacity: 0.5; }
        100% { transform: scale(1.5); opacity: 0; }
    }
    .badge-icon {
        font-size: 13px;
        margin-right: 6px;
        display: flex;
        align-items: center;
    }
    .badge-text {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
        text-align: left;
    }
    .badge-title {
        font-size: 9px;
        font-weight: 700;
        color: #00f0ff;
        letter-spacing: 0.5px;
    }
    .glow-badge.orange .badge-title {
        color: #ff9f00;
    }
    .badge-sub {
        font-size: 8px;
        color: rgba(255, 255, 255, 0.85);
        font-weight: 600;
    }
    /* ── Hospital Glow Marker ── */
    .hosp-glow-marker {
        background: #ff9f00;
        color: #fff;
        border: 1.5px solid #fff;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 12px #ff9f00;
        font-size: 11px;
    }
    /* ── Patient Glow Marker ── */
    .patient-glow-marker {
        position: relative;
        width: 14px;
        height: 14px;
        background: #ff4d4d;
        border-radius: 50%;
        border: 2px solid #fff;
        box-shadow: 0 0 10px #ff4d4d;
    }
    .patient-pulse {
        position: absolute;
        width: 30px;
        height: 30px;
        border: 2px solid #ff4d4d;
        border-radius: 50%;
        top: -10px;
        left: -10px;
        animation: patient-pulse-ring 1.8s ease-out infinite;
    }
    @@keyframes patient-pulse-ring {
        0% { transform: scale(0.5); opacity: 1; }
        100% { transform: scale(1.8); opacity: 0; }
    }
    /* Card design from WellNest reference */
    .dashboard-card {
        background: #FFFFFF;
        border: 1px solid var(--card-border);
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
        padding: 24px;
        margin-bottom: 24px;
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
        position: relative;
    }
    .dashboard-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.04);
    }
    .card-title-lg {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--text-dark);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    /* Stats telemetry style */
    .stat-box-container {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }
    .stat-box {
        flex: 1;
        min-width: 220px;
        background: #FFFFFF;
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.01);
        transition: all 0.3s;
    }
    .stat-box:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.03);
    }
    .stat-box-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--text-muted);
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 12px;
    }
    .stat-box-val {
        font-size: 2.2rem;
        font-weight: 900;
        color: var(--text-dark);
        line-height: 1.1;
        font-family: sans-serif;
    }
    .stat-trend {
        font-size: 0.75rem;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-top: 8px;
        width: fit-content;
    }
    .trend-up { background: #E8F8F5; color: #27AE60; }
    .trend-down { background: #FDE8E8; color: #E74C3C; }
    .trend-warning { background: #FEF9E7; color: #F39C12; }
    /* Custom Triage Table styled like WellNest Appointments */
    .triage-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 12px;
        margin-top: -12px;
    }
    .triage-table th {
        border: none;
        color: var(--text-muted);
        font-weight: 800;
        font-size: 0.85rem;
        padding: 8px 16px;
    }
    .triage-row {
        background: #FFFFFF;
        border-radius: 16px;
        transition: all 0.3s;
    }
    .triage-row td {
        padding: 18px 16px;
        border-top: 1px solid var(--card-border);
        border-bottom: 1px solid var(--card-border);
        background: #FFFFFF;
        font-size: 0.9rem;
        font-weight: 600;
    }
    .triage-row td:first-child {
        border-right: 1px solid var(--card-border);
        border-top-right-radius: 16px;
        border-bottom-right-radius: 16px;
    }
    .triage-row td:last-child {
        border-left: 1px solid var(--card-border);
        border-top-left-radius: 16px;
        border-bottom-left-radius: 16px;
    }
    .triage-row:hover td {
        background: #F9FBFC;
        border-color: rgba(26, 111, 191, 0.2);
    }
    .triage-row:hover {
        box-shadow: 0 8px 25px rgba(0,0,0,0.03);
    }
    /* Badges */
    .priority-badge {
        font-size: 0.72rem;
        font-weight: 900;
        padding: 3px 10px;
        border-radius: 8px;
        text-transform: uppercase;
        font-family: sans-serif;
    }
    .prio-high { background: #FDE8E8; color: #E74C3C; box-shadow: 0 0 10px rgba(231,76,60,0.15); }
    .prio-med { background: #FEF9E7; color: #F39C12; }
    .prio-low { background: #E8F8F5; color: #27AE60; }
    .status-badge {
        font-size: 0.78rem;
        font-weight: 800;
        padding: 4px 12px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .status-pending { background: #FEF9E7; color: #D35400; }
    .status-accepted { background: #E8F8F5; color: #27AE60; }
    .status-escalated { background: #FDE8E8; color: #C0392B; animation: heartBeat 1.5s infinite; }
    /* Support trigger button style */
    .btn-emergency-support {
        background: linear-gradient(135deg, #E74C3C 0%, #C0392B 100%);
        border: none;
        color: white;
        font-weight: 800;
        box-shadow: 0 4px 15px rgba(231, 76, 60, 0.35);
        transition: all 0.3s;
        border-radius: 30px;
        position: relative;
        overflow: hidden;
    }
    .btn-emergency-support:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(231, 76, 60, 0.5);
        color: white;
    }
    .btn-emergency-support::after {
        content: '';
        position: absolute;
        top: 0; left: -50%;
        width: 200%; height: 100%;
        background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.3) 50%, rgba(255,255,255,0) 100%);
        transform: skewX(-25deg);
        animation: support-shine 3s infinite;
    }
    @@keyframes support-shine {
        0% { left: -150%; }
        50% { left: 150%; }
        100% { left: 150%; }
    }
    /* Tabs Styling */
    .triage-tabs .nav-link {
        border: none;
        border-bottom: 3px solid transparent;
        color: var(--text-muted);
        font-weight: 800;
        padding: 12px 20px;
        border-radius: 0;
        transition: all 0.3s;
    }
    .triage-tabs .nav-link.active {
        background: transparent;
        color: var(--primary);
        border-bottom-color: var(--primary);
    }
    .triage-tabs .nav-link:hover:not(.active) {
        color: var(--primary-dark);
        border-bottom-color: var(--primary-light);
    }
    /* Mobile responsive fixes */
    @@media (max-width: 767px) {
        .stat-box { min-width: 150px !important; }
        .stat-box-container { gap: 0.75rem !important; }
        .triage-table th, .triage-table td { font-size: 0.75rem !important; padding: 0.5rem 0.4rem !important; }
        .triage-tabs {
            flex-wrap: nowrap !important;
            overflow-x: auto !important;
            overflow-y: hidden !important;
            white-space: nowrap !important;
            -webkit-overflow-scrolling: touch !important;
            padding-bottom: 5px !important;
            border-bottom: 1px solid var(--card-border) !important;
        }
        .triage-tabs .nav-item {
            flex: 0 0 auto !important;
        }
        .triage-tabs .nav-link {
            padding: 10px 12px !important;
            font-size: 0.8rem !important;
        }
    }
</style>
<!-- Main Row -->
<div class="row g-4 animate__animated animate__fadeIn">
    <!-- Top summary widget header -->
    <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-3 mb-2">
        <div>
            <h2 class="fw-900 m-0" style="font-weight: 900;">لوحة الفرز والانتظار - @Model.ProviderName</h2>
            <p class="text-muted small mb-0"><i class="fas fa-stethoscope me-1"></i> غرفة عمليات فرز وتوجيه عربات الإسعاف وتتبع السعة الاستيعابية والمواقع للمستشفى</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- AI Auto Accept Toggle -->
            <div class="form-check form-switch d-inline-flex align-items-center gap-2 border px-3 py-2 rounded-pill bg-transparent shadow-sm" style="cursor: pointer; height: 42px; margin-bottom: 0;">
                <input class="form-check-input ms-0" type="checkbox" role="switch" id="aiAutoAcceptToggle" @(ViewBag.IsAiModeActive == true ? "checked" : "") onchange="toggleAiMode(@Model.ProviderId, this.checked)" style="cursor: pointer;">
                <label class="form-check-label fw-800 text-dark" for="aiAutoAcceptToggle" style="font-size: 0.82rem; cursor: pointer; user-select: none;">
                    <i class="fas fa-robot text-primary animate__animated animate__pulse animate__infinite"></i> الفرز الآلي بالذكاء الاصطناعي
                </label>
            </div>
            <!-- Audio Alarm Toggle -->
            <button id="btnToggleAudio" class="btn btn-outline-success rounded-pill px-3 py-2 fw-800 shadow-sm" onclick="toggleAudioMute()" style="height: 42px; display: inline-flex; align-items: center; gap: 6px;">
                <i class="fas fa-volume-up" id="audioToggleIcon"></i> <span id="audioToggleText">التنبيه الصوتي: مفعل</span>
            </button>
            <!-- Export Report -->
            <a href="/HospitalQueue/ExportReport?providerId=@Model.ProviderId" class="btn btn-outline-success rounded-pill px-4 py-2 fw-800 shadow-sm" style="height: 42px; display: inline-flex; align-items: center; gap: 6px;">
                <i class="fas fa-file-excel"></i> تصدير التقرير
            </a>
        </div>
    </div>
    <!-- Stats Boxes Grid -->
    <div class="col-12" id="statsSectionContainer" 
         data-critical-count="@criticalCount" 
         data-medium-count="@mediumCount" 
         data-low-count="@lowCount" 
         data-available-beds="@(Model.AvailableBeds ?? 0)" 
         data-bed-capacity="@(Model.BedCapacity ?? 150)">
        <div class="stat-box-container">
            <!-- Bed Stats -->
            <div class="stat-box">
                <div class="stat-box-header">
                    <span>الأسرة المتاحة حالياً</span>
                    <i class="fas fa-bed text-primary fs-5"></i>
                </div>
                <div class="stat-box-val" id="telemetryBeds">@(Model.AvailableBeds.HasValue ? Model.AvailableBeds.Value.ToString() : "0")</div>
                <div class="stat-trend trend-up">
                    <i class="fas fa-check"></i> جاهز للاستقبال
                </div>
            </div>
            <!-- Pending Stats -->
            <div class="stat-box">
                <div class="stat-box-header">
                    <span>حالات إسعاف قادمة (معلقة)</span>
                    <i class="fas fa-ambulance text-warning fs-5 animate__animated animate__flash animate__infinite animate__slower"></i>
                </div>
                <div class="stat-box-val">@Model.PendingCount</div>
                <div class="stat-trend trend-warning">
                    <i class="fas fa-clock"></i> انتظار تأكيد الفرز
                </div>
            </div>
            <!-- Accepted Stats -->
            <div class="stat-box">
                <div class="stat-box-header">
                    <span>الحالات المستقرة المقبولة</span>
                    <i class="fas fa-check-double text-success fs-5"></i>
                </div>
                <div class="stat-box-val">@Model.AcceptedCount</div>
                <div class="stat-trend trend-up">
                    <i class="fas fa-plus"></i> قيد المتابعة بالمستشفى
                </div>
            </div>
            <!-- Escalated Stats -->
            <div class="stat-box">
                <div class="stat-box-header">
                    <span>الحالات المتدهورة (المصعدة)</span>
                    <i class="fas fa-triangle-exclamation text-danger fs-5"></i>
                </div>
                <div class="stat-box-val">@Model.EscalatedCount</div>
                <div class="stat-trend trend-down">
                    <i class="fas fa-exclamation-triangle"></i> بحاجة لطبيب طوارئ
                </div>
            </div>
        </div>
    </div>
    <!-- Left side: Charts and Cases -->
    <div class="col-lg-8">
        <!-- Professional Analytics Row -->
        <div class="dashboard-card">
            <h3 class="card-title-lg mb-4">
                <i class="fas fa-chart-pie text-primary"></i>
                التحليلات والمؤشرات الإحصائية الفورية
            </h3>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div style="position: relative; height: 220px; width: 100%;">
                        <canvas id="bedStatusChart"></canvas>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div style="position: relative; height: 220px; width: 100%;">
                        <canvas id="priorityChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <!-- Cases segmented lists -->
        <div class="dashboard-card" id="queueTablesContainer">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <h3 class="card-title-lg m-0" style="font-size: 1.2rem;">
                    <i class="fas fa-list-ol text-primary"></i>
                    تصنيفات وقوائم فرز الحالات الطارئة
                </h3>
            </div>
            <ul class="nav nav-tabs triage-tabs mb-3" id="triageTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="general-pending-tab" data-bs-toggle="tab" data-bs-target="#general-pending-pane" type="button" role="tab">
                        <i class="fas fa-truck-medical text-warning"></i> طلبات الإسعاف العامة 
                        <span class="badge bg-warning text-dark ms-1 rounded-pill">@generalPending.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="direct-pending-tab" data-bs-toggle="tab" data-bs-target="#direct-pending-pane" type="button" role="tab">
                        <i class="fas fa-hospital-user text-primary"></i> طلبات الاستقبال المباشرة 
                        <span class="badge bg-primary text-white ms-1 rounded-pill">@directPending.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="accepted-tab" data-bs-toggle="tab" data-bs-target="#accepted-pane" type="button" role="tab">
                        <i class="fas fa-check-circle text-success"></i> المقبولة والنشطة
                        <span class="badge bg-success ms-1 rounded-pill">@acceptedItems.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="escalated-tab" data-bs-toggle="tab" data-bs-target="#escalated-pane" type="button" role="tab">
                        <i class="fas fa-triangle-exclamation text-danger"></i> المتدهورة/الحرجة
                        <span class="badge bg-danger ms-1 rounded-pill animate__animated animate__flash animate__infinite">@escalatedItems.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="transfers-tab" data-bs-toggle="tab" data-bs-target="#transfers-pane" type="button" role="tab">
                        <i class="fas fa-hospital-user text-info"></i> تحويلات الأطباء
                        <span class="badge bg-info text-white ms-1 rounded-pill">@doctorTransfers.Count(t => t.Status == "Pending")</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="admitted-tab" data-bs-toggle="tab" data-bs-target="#admitted-pane" type="button" role="tab" onclick="loadAdmittedPatients()">
                        <i class="fas fa-bed-pulse text-secondary"></i> المنوّمين بالمنشأة
                        <span class="badge bg-secondary text-white ms-1 rounded-pill" id="admittedCountBadge">0</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="bed-grid-tab" data-bs-toggle="tab" data-bs-target="#bed-grid-pane" type="button" role="tab" onclick="renderBedsGrid()">
                        <i class="fas fa-border-all text-dark"></i> مخطط الأسرة
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="handovers-tab" data-bs-toggle="tab" data-bs-target="#handovers-pane" type="button" role="tab">
                        <i class="fas fa-clipboard-list text-info"></i> تسليم الوردية
                    </button>
                </li>
            </ul>
            <!-- Search & Sort Controls for Hospital Queue (Client-side) -->
            <div class="row g-2 mb-4 p-3 border rounded-4 bg-transparent align-items-center">
                <div class="col-md-6 col-12">
                    <label class="form-label small fw-bold text-dark mb-1">بحث سريع في قائمة الحالات</label>
                    <div class="input-group">
