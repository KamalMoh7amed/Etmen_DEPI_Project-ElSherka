@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function updateBedCapLabel(val) {
            document.getElementById('bedCapVal').innerText = val;
            const bedRange = document.getElementById('bedRange');
            if (bedRange) {
                bedRange.setAttribute('max', val);
                if (parseInt(bedRange.value) > parseInt(val)) {
                    bedRange.value = val;
                    document.getElementById('bedVal').innerText = val;
                    updateBedColor(val);
                }
            }
            if (window.bedChart) {
                const available = bedRange ? parseInt(bedRange.value) : 0;
                const total = parseInt(val);
