                                    <option value="العناية المركزة">العناية المركزة</option>
                                    <option value="العمليات">العمليات</option>
                                    <option value="جاهز للخروج">جاهز للخروج</option>
                                </select>
                            </td>
                            <td>
                                <div class="text-muted small">${dateStr}</div>
